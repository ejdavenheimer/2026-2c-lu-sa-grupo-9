@startuml diagrama-clases

enum UnidadCompromiso {
    HORAS_TOTALES
    HORAS_SEMANALES
    HORAS_MENSUALES
}

enum ModalidadColaboracion {
    GRATUITA
    CON_INCENTIVO_ECONOMICO
    CON_POSIBILIDAD_CONTRATACION
}

enum TipoCuenta {
    GITHUB
    GITLAB
}

enum EstadoProyecto {
    PUBLICADO
    CERRADO
}

enum TipoMedioContacto {
    EMAIL
    WHATSAPP
    SMS
}

class Colectivo {
    nombre: String
    descripcion: String
    tipo: TipoColectivo
    ubicacion: Ubicacion
    proyectos: Proyecto[]
    --
    agregarProyecto(proyecto)
    finalizarProyecto(proyecto)
}

class TipoColectivo {
    nombre: String
}

class Ubicacion {
    pais: Pais
    provincia: Provincia
    ciudad: String
}

class Pais {
    nombre: String
}

class Provincia {
    nombre: String
}

class Proyecto {
    titulo: String
    descripcion: String
    unidadCompromiso: UnidadCompromiso
    cantidadHoras: int
    modalidadesColaboracion: ModalidadColaboracion[]
    estado: EstadoProyecto
    fechaAlta: Date
    fechaCierre: Date
    colectivo: Colectivo
    habilidadesRequeridas: Habilidad[]
    colaboraciones: Colaboracion[]
    perfiles: Perfil[]
    --
    agregarColaboracion(PersonaColaboradora)
'   se instancia la colaboracion y se pasa por parametro la persona colaboradora
    validarColaborador(PersonaColaboradora)
    agregarPerfil(perfil)
    cerrarProyecto()
}

class Perfil {
    nombre: String
    descripcion: String
    unidadCompromiso: UnidadCompromiso
    cantidadHoras: int
    modalidadesColaboracion: ModalidadColaboracion[]
    habilidadesRequeridas: Habilidad[]
    habilidadesOpcionales: Habilidad[]
    proyecto: Proyecto
    --
    validarColaborador(PersonaColaboradora)
    cumpleTodasRequeridas(PersonaColaboradora)
    calcularAfinidadOpcionales(PersonaColaboradora)
    evaluarCompatibilidad(PersonaColaboradora)
}

class Compatibilidad {
    perfil: Perfil
    personaColaboradora: PersonaColaboradora
    puntaje: float
    requeridasFaltantes: Habilidad[]
    opcionalesCumplidas: Habilidad[]
    opcionalesFaltantes: Habilidad[]
    --
    esCompatible(): Boolean
    cumpleAlgunaRequerida(): Boolean
    proyecto(): Proyecto
    {static} compararPorPuntaje(unaCompatibilidad, otraCompatibilidad)
}

class Colaboracion {
    fechaInscripcion: Date
    personaColaboradora: PersonaColaboradora
    esAnonima: Boolean
    proyecto: Proyecto
}

class PersonaColaboradora {
    nombreFantasia: String
    nombre: String
    apellido: String
    pronombres: String[]
    presentacion: String
    mensajesInternos: Boolean
    mediosDeContacto: MedioDeContacto[]
    cuentas: Cuenta[]
    habilidades: Habilidad[]
    colaboraciones: Colaboracion[]
    --
    agregarHabilidad(habilidad)
    agregarColaboracion(colaboracion)
    agregarMedioDeContacto(medio)
    actualizarMediosDeContacto(medio)
    aceptaMensajesInternos(): Boolean
}

class MedioDeContacto {
    tipo: TipoMedioContacto
    valor: String
}

class Habilidad {
    titulo: String
    codigo: String
    descripcion: String
}

class Cuenta {
    nombreUsuario: String
    tipo: TipoCuenta
}

' ==========================================================
' Módulo de Notificaciones y Envíos Externos
' ==========================================================

class Notificacion {
    id: String
    contenido: String
    fecha: Date
    leida: Boolean
    colectivo: Colectivo
    personaColaboradora: PersonaColaboradora
    perfil: Perfil
    mediosExternosUtilizados: MedioUtilizado[]
    --
    marcarLeida()
    setLeida(estado)
    registrarMedioUtilizado(medio)
}

class MedioUtilizado {
    tipo: TipoMedioContacto
    valor: String
    fechaEnvio: Date
    exitoso: Boolean
    error: String
}

class NotificadorSender {
    estrategias: Map<TipoMedioContacto, EstrategiaNotificacion>
    --
    notificarPorMedio(medio, notificacion)
    replicarPorMedios(medios, notificacion)
}

interface EstrategiaNotificacion <<interface>> {
    notificar({ destinatario, mensaje, notificacion })
}

class EstrategiaNotificacionEmail {
    transporter: Transporter
    --
    notificar({ destinatario, mensaje, notificacion })
}

class EstrategiaNotificacionWhatsApp {
    client: TwilioClient
    --
    notificar({ destinatario, mensaje, notificacion })
}

class EstrategiaNotificacionSMS {
    client: TwilioClient
    --
    notificar({ destinatario, mensaje, notificacion })
}

' Relaciones estructurales del Dominio
Colectivo --> TipoColectivo
Colectivo --> Ubicacion

Ubicacion --> Pais
Ubicacion --> Provincia

Proyecto <--> Colectivo
Proyecto <--> Colaboracion
Proyecto --> Habilidad
Proyecto --> EstadoProyecto
Proyecto --> ModalidadColaboracion
Proyecto --> UnidadCompromiso
Proyecto *--> Perfil

Perfil --> Habilidad
Perfil --> ModalidadColaboracion
Perfil --> UnidadCompromiso
Perfil ..> Compatibilidad
Compatibilidad --> Perfil
Compatibilidad --> PersonaColaboradora
Compatibilidad --> Habilidad

Colaboracion <--> PersonaColaboradora

PersonaColaboradora --> Habilidad
PersonaColaboradora --> Cuenta
PersonaColaboradora *--> MedioDeContacto

Cuenta --> TipoCuenta
MedioDeContacto --> TipoMedioContacto

' Relaciones del Módulo de Notificaciones
Notificacion --> Colectivo
Notificacion --> PersonaColaboradora
Notificacion --> Perfil
Notificacion *--> MedioUtilizado
MedioUtilizado --> TipoMedioContacto

' Patrón Strategy de Notificaciones
NotificadorSender --> EstrategiaNotificacion
NotificadorSender ..> Notificacion
NotificadorSender ..> MedioDeContacto

EstrategiaNotificacion <|.. EstrategiaNotificacionEmail
EstrategiaNotificacion <|.. EstrategiaNotificacionWhatsApp
EstrategiaNotificacion <|.. EstrategiaNotificacionSMS

@enduml
